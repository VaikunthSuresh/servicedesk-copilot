# Copy this file to backend/.env and add YOUR OWN key. Never commit or share backend/.env.
# Any OpenAI-compatible endpoint works:
#   OpenAI : LLM_BASE_URL=https://api.openai.com/v1          LLM_MODEL=gpt-4o-mini
#   Groq   : LLM_BASE_URL=https://api.groq.com/openai/v1     LLM_MODEL=llama-3.1-8b-instant   (free tier)
#   Ollama : LLM_BASE_URL=http://localhost:11434/v1          LLM_MODEL=llama3.2               (local, no key)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional: the fine-tuned router. Leave unset to use finetune/outputs/v2_6cls_merged automatically.
# CLASSIFIER_MODEL=
